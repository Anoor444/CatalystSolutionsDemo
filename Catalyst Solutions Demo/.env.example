# Copy this file to .env (same folder) and fill in your values. .env is never committed.
# On Vercel, enter the same names under Project Settings -> Environment Variables.

# --- Local MySQL (after running setup_mysql.sql) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=catalyst_app
MYSQL_PASSWORD=REPLACE_WITH_YOUR_PASSWORD
MYSQL_DATABASE=catalyst_demo
MYSQL_SSL=false

# --- Hosted MySQL (TiDB Cloud / Amazon RDS): use the values from its "Connect" page ---
# MYSQL_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
# MYSQL_PORT=4000
# MYSQL_USER=xxxxxxxx.root
# MYSQL_PASSWORD=...
# MYSQL_DATABASE=catalyst_demo
# MYSQL_SSL=true
# MYSQL_SSL_CA=certs/global-bundle.pem   # Amazon RDS only

# --- Website secret key (required on Vercel; on your computer one is made automatically) ---
# Create one with:  python -c "import secrets; print(secrets.token_hex(32))"
# FLASK_SECRET_KEY=

# Optional
# MYSQL_POOL_SIZE=3
# MYSQL_TEST_DATABASE=catalyst_test
# APP_TIMEZONE=America/Chicago
